---
import '@/styles/globals.css';
import '@/styles/angles.css';

import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MartaCodes.it',
  description = 'Marta Pancaldi — Full-Stack Software Engineer',
} = Astro.props;
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content={description} />
    <link rel='icon' type='image/x-icon' href='/favicon.ico' />
    <title>{title}</title>

    <!-- Preload Fonts -->

    <!-- Google Fonts for decorative fonts used in Updates section (non-render-blocking) -->
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      rel='preload'
      as='style'
      href='https://fonts.googleapis.com/css2?family=Handlee&family=Reenie+Beanie&family=Square+Peg&display=swap'
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel='stylesheet'
        href='https://fonts.googleapis.com/css2?family=Handlee&family=Reenie+Beanie&family=Square+Peg&display=swap'
      />
    </noscript>

    <!-- Theme init: read localStorage before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        document.documentElement.classList.add(theme);
      })();
    </script>

    <!--
      Staggered reveal for `[data-reveal-group]` children.

      Inline and in the head on purpose: the `js-reveal` class has to land
      before first paint, or items flash in at full opacity and then get
      hidden. Everything stays in one script so there is no separate file that
      can fail to load and leave the page permanently blank — and if anything
      here throws, the catch drops the class and the page renders as plain,
      visible HTML.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var show = function () {
          root.classList.remove('js-reveal');
        };

        if (!('IntersectionObserver' in window)) return;
        root.classList.add('js-reveal');

        try {
          var revealedAny = false;
          var known = new WeakSet();

          var io = new IntersectionObserver(
            function (entries) {
              // Stagger within each batch rather than by index in the group:
              // item 40 shouldn't wait 40 steps, and a row scrolled into view
              // should still cascade.
              entries
                .filter(function (entry) {
                  return entry.isIntersecting;
                })
                .sort(function (a, b) {
                  return a.boundingClientRect.top - b.boundingClientRect.top;
                })
                .forEach(function (entry, index) {
                  var el = entry.target;
                  io.unobserve(el);
                  // Stagger with timers rather than animation-delay — see the
                  // note in globals.css.
                  setTimeout(function () {
                    revealedAny = true;
                    el.setAttribute('data-revealed', '');
                  }, index * 70);
                });
            },
            { threshold: 0.05, rootMargin: '0px 0px -5% 0px' }
          );

          // Only arm once there is actually something to reveal. Every page
          // here is `client:only`, so React may take a while to render — a
          // timer started up front would fire against an empty document and
          // switch the effect off before it ever ran.
          var armed = false;
          var armFailsafe = function () {
            if (armed) return;
            armed = true;
            var start = function () {
              setTimeout(function () {
                if (!revealedAny) show();
              }, 3000);
            };
            if (document.hidden) {
              document.addEventListener(
                'visibilitychange',
                function onVisible() {
                  if (document.hidden) return;
                  document.removeEventListener('visibilitychange', onVisible);
                  start();
                }
              );
            } else {
              start();
            }
          };

          var scan = function () {
            var items = document.querySelectorAll('[data-reveal-group] > *');
            for (var i = 0; i < items.length; i++) {
              if (known.has(items[i])) continue;
              known.add(items[i]);
              io.observe(items[i]);
            }
            if (items.length) armFailsafe();
          };

          // The pages are `client:only="react"`, so none of this markup exists
          // at DOMContentLoaded — it has to be picked up as React inserts it.
          // Debounced to one scan per frame, since this watches the whole tree
          // and React re-renders on interaction.
          var queued = false;
          var mo = new MutationObserver(function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () {
              queued = false;
              scan();
            });
          });
          mo.observe(root, { childList: true, subtree: true });
          scan();
        } catch (e) {
          show();
        }
      })();
    </script>
  </head>

  <body>
    <Header />
    <main id='content' class='min-h-main dark:bg-dark bg-white'>
      <slot />
    </main>
    <Footer client:idle />

    <!-- CookieYes -->
    <script
      is:inline
      defer
      id='cookieyes'
      type='text/javascript'
      src='https://cdn-cookieyes.com/client_data/343cca4a060bf9189f75d72e/script.js'
    ></script>
  </body>
</html>
