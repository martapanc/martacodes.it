---
import readCodeSnippets from '@/lib/markdownUtils';
import { loadProjects } from '@/lib/loadProjects';
import homePageData from '@/data/en/home.json';

import RootLayout from '@/layouts/RootLayout.astro';
import HomePage from '@/components/pages/home-page';

const projects = loadProjects();

const { snippets: codeSnippets, latestEditTimestamp } = readCodeSnippets();
---

<RootLayout
  title='Marta Pancaldi | MartaCodes.it'
  description="I'm a software engineer who writes code for work and for fun."
>
  <HomePage
    homePage={homePageData}
    codeSnippets={codeSnippets}
    snippetsUpdatedAt={latestEditTimestamp}
    projects={projects}
    client:only="react"
  />
</RootLayout>
